# ==========================================================
# Contoh konfigurasi Zsh
# Gabungkan dengan ~/.zshrc setelah membuat cadangan.
# ==========================================================

# Lokasi instalasi Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"

# Tema Powerlevel10k
# Pastikan Powerlevel10k sudah dipasang pada akun ini.
ZSH_THEME="powerlevel10k/powerlevel10k"

# Plugin Oh My Zsh
# Plugin harus tersedia di instalasi Oh My Zsh.
plugins=(git)

# Memuat Oh My Zsh
source "$ZSH/oh-my-zsh.sh"

# Riwayat perintah
HISTFILE="$HOME/.zsh_history"
HISTSIZE=5000
SAVEHIST=5000
setopt HIST_IGNORE_DUPS
setopt SHARE_HISTORY

# Alias sederhana
alias ll="ls -lah"
alias cls="clear"
alias ..="cd .."

# Memuat konfigurasi Powerlevel10k jika tersedia.
# File ini biasanya dibuat oleh wizard `p10k configure`.
[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
